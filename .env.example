# Environment & Server
ENV=development
PUBLIC_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:8000
ALLOW_SIMULATED_GPS=true

# Database & Redis
DATABASE_URL=postgresql://along:along_dev_password@localhost:5433/along
DIRECT_DATABASE_URL=postgresql://along:along_dev_password@localhost:5433/along
REDIS_URL=redis://localhost:6381/0

# LLM Configuration (OpenAI Compatible Endpoints)
# Level 1: primary. Tried with LLM_TIMEOUT_SECONDS and one retry.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER_LABEL=
LLM_TIMEOUT_SECONDS=8
LLM_MAX_TOKENS=1500

# Level 2: fallback. Tried when the primary fails. Then the rule-based fallback runs.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_PROVIDER_LABEL=

# Speech-to-Text (ASR) Fallback Endpoint
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3-turbo

# Optional Meta Model API (Disabled when empty)
META_API_KEY=
MODEL_API_KEY=
META_MODEL_API_BASE_URL=

# Spatial & Vector Index
FAISS_ARTIFACT_DIR=./data/faiss

# WhatsApp Integration
WHATSAPP_TRANSPORT=emulator
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=along_verify_token_2026

# Payments
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Cryptographic Secrets
JWT_SECRET_KEY=replace_me_with_32_byte_hex
OTP_PEPPER=replace_me_with_32_byte_hex
NIN_PEPPER=replace_me_with_32_byte_hex
LOG_HASH_SALT=replace_me_with_32_byte_hex
SEED_OPS_PASSWORD=replace_me_ops_password_2026

# Web Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@along.ai
